{
  "name": "openwiki",
  "version": "0.5.0",
  "description": "A CLI that uses a DeepAgents documentation agent to generate and maintain an OpenWiki for a codebase.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openwiki": "./dist/cli/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langchain-ai/openwiki.git"
  },
  "bugs": {
    "url": "https://github.com/langchain-ai/openwiki/issues"
  },
  "homepage": "https://github.com/langchain-ai/openwiki#readme",
  "files": [
    "dist",
    "integrations",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "documentation",
    "wiki",
    "deepagents",
    "langchain",
    "cli"
  ],
  "scripts": {
    "openwiki": "node dist/cli/cli.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/copy-visualize-assets.cjs",
    "changeset:version": "changeset version",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "vitest run --coverage",
    "dev": "tsx src/cli/cli.tsx",
    "eval:ledger": "tsx evals/ledger/run.ts",
    "eval:ledger:reevaluate": "tsx evals/ledger/reevaluate.ts",
    "eval:ledger:typecheck": "tsc --noEmit -p evals/ledger/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integrations:dev": "pnpm run build && node scripts/install-local-integration.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli/cli.js', 0o755)\"",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm run build",
    "release": "pnpm run stamp:channel && pnpm run build && changeset publish",
    "stamp:channel": "node scripts/stamp-build-channel.cjs",
    "start": "node dist/cli/cli.js",
    "test": "pnpm run typecheck && pnpm run build && pnpm run coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.6",
    "@aws-sdk/client-bedrock-runtime": "^3.1120.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/aws": "^1.4.4",
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.5.11",
    "@langchain/openrouter": "^0.4.10",
    "@langchain/protocol": "^0.0.19",
    "@langchain/tavily": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ci-info": "^4.4.0",
    "cron-parser": "5.10.0",
    "cronstrue": "3.24.0",
    "deepagents": "1.13.2",
    "google-auth-library": "^11.0.2",
    "ink": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.9.0",
    "marked": "^18.0.11",
    "posthog-node": "^5.51.4",
    "react": "^18.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0"
}
