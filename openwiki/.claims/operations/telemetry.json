    {
      "id": "claim_2dc61c5cf5ea48208f26d4f336f41078",
      "statement": "withRunTelemetry is the single boundary that records exactly one openwiki_run event, wrapping the whole setup->connectors->agent sequence so a failure anywhere in it is recorded once, and rethrowing so the CLI still owns the failure UX.",
      "evidence": [
        {
          "resource": "repo://src/telemetry/with-run-telemetry.ts#L39-L85",
          "version": "repo-lines-v1:sha256:1d8f62ee9ca7860a6fd35f59943bd1800202523be70135050759354f151f3a98:"
        }
      ]
    },
    {
      "id": "claim_85bcfc1da9a24dfdaaafeaa666037c04",
      "statement": "A mutable RunTelemetryContext lets the boundary sit outside the agent while still attributing the provider and a noop short-circuit that are only knowable inside the agent, which writes those facts as they become known.",
      "evidence": [
        {
          "resource": "repo://src/telemetry/with-run-telemetry.ts#L7-L37",
          "version": "repo-lines-v1:sha256:bd6216e8629846d93bfac5394e5456b381b993a9b5bc334d00444f6a39c97efc:"
        }
      ]
    },
    {
      "id": "claim_ef6a5efea01b4a2c9273a0a3a7bd94a1",
