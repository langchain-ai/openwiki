    {
      "id": "claim_e8d88761dca44abcaf3abb50a2fb4312",
      "statement": "saveOpenWikiEnv serializes all writes through a promise queue so concurrent saves cannot interleave, and a rejected save is swallowed in the queue chain so it does not permanently block later saves while the caller still receives the original error.",
