    {
      "id": "claim_7cfcc605127d43e3badbff773fc7c076",
      "statement": "saveOpenWikiEnvLocked writes the env file atomically by writing to a uniquely named temp file (mode 0o600) in the same directory and renaming it into place, avoiding the O_TRUNC data-loss window of a plain writeFile that could truncate ~/.openwiki/.env and lose saved tokens on a mid-write failure.",
      "evidence": [
        {
          "resource": "repo://src/config/env.ts#L342-L353",
