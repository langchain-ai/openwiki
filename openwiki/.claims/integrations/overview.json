    },
    {
      "id": "claim_35c4864bfdbd412399b416b57b04ce45",
      "statement": "Host instructions require resolving the absolute Git top-level and calling openwiki_begin before authoring; if begin returns status=noop the host must report no update required and stop, otherwise submit a plan then loop next_page/submit_page, and never report success before finish returns complete. They forbid the host from directly editing OpenWiki-owned Claims sidecars, indexes, logs, provenance, run metadata, setup blocks, or workflows.",
      "evidence": [
        {
          "resource": "repo://src/integrations/mcp/server.ts#L10-L26",
          "version": "repo-lines-v1:sha256:546b73bea54c77bf35015cb11d61e5aa62cd61209f0c094207c7323df85743ce:"
        }
      ]
    },
    {
      "id": "claim_0b83a743c1e447f58359e99c4faf5ef5",
      "statement": "resolveRepositoryRoot canonicalizes the candidate to its Git worktree top-level and refuses a non-absolute path, the filesystem root, and the user's home directory so an ambiguous launch directory is not treated as a wiki repository.",
      "evidence": [
        {
          "resource": "repo://src/integrations/core/repository-root.ts#L117-L133",
          "version": "repo-lines-v1:sha256:bfa84d82377d09e4338e8f6137533971982931a651516cc6982902a4033d8d16:"
