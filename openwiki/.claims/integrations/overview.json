    {
      "id": "claim_ce704dd5eb0048499e0a727782fe0838",
      "statement": "The MCP adapter bounds transport-visible errors: a HostIntegrationError surfaces its code and message while any other exception returns a generic failure message so unknown exception data is never exposed.",
      "evidence": [
        {
          "resource": "repo://src/integrations/mcp/server.ts#L73-L91",
          "version": "repo-lines-v1:sha256:f16871785176038f382b67839f1181fddf3ef6162d81a262d03d67c145b2652a:"
        }
      ]
    },
    {
      "id": "claim_373b7db2e536420698fe2fe25d1fa88d",
      "statement": "The MCP server is a thin adapter over a transport-neutral lifecycle provider, advertising host instructions and registering each provider tool.",
      "evidence": [
        {
          "resource": "repo://src/integrations/mcp/server.ts#L40-L64",
          "version": "repo-lines-v1:sha256:6a950a603aa9255d189d98579bc93e6e60c746b7f9de0fe8daca8f949d6fd43b:"
        }
