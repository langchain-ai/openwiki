        }
      ]
    },
    {
      "id": "claim_d264b97b33a24686be6aa340a8cd5200",
      "statement": "The begin request validates root, an init/update mode, an optional language, and an optional force flag; submit_plan, next_page, submit_page, and finish requests all require a UUID runId, and submit_page additionally requires a UUID jobId and a non-empty claims array.",
      "evidence": [
        {
          "resource": "repo://src/integrations/core/protocol.ts#L56-L132",
          "version": "repo-lines-v1:sha256:cf286933ba7537672cb43e8c2cde16dd66cd28265b15ae60f9eeed0d4ad9907a:"
        }
