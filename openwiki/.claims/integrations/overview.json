    {
      "id": "claim_6581d65de00647fe989b4eca8b582810",
      "statement": "openwiki_submit_plan accepts the complete page plan with canonical paths, titles, purposes, optional seedPaths, relatedPages, and instructions, plus an optional deletePages set; it is only accepted during the planning phase, durably persists the ordered PageJob queue, transitions the run to generating, and refuses to silently replace an already-persisted plan unless the resubmission is semantically identical.",
      "evidence": [
