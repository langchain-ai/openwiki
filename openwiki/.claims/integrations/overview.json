    {
      "id": "claim_e6e2a8197c364a8c84bcc6f9ae971a8d",
      "statement": "The integration exposes a fixed five-tool V0.4 lifecycle over MCP — openwiki_begin, openwiki_submit_plan, openwiki_next_page, openwiki_submit_page, and openwiki_finish — superseding the earlier V1 begin/inspect_claims/resolve_claims/finish protocol.",
      "evidence": [
