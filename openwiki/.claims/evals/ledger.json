        }
      ]
    },
    {
      "id": "claim_d684fe4d88e7461299760d522f49600c",
      "statement": "The system under test and the evaluator are separate backends: an OpenWikiSystem produces the wiki while a ModelEvaluationBackend scores it, each configured with its own model id.",
