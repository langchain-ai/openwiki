    {
      "id": "claim_f2da080311044b40aeacc46ae1f3df7d",
      "statement": "reevaluate.ts re-scores a completed run without invoking the System Under Test, but still loads the benchmark because source is the ground truth read at each checkpoint's commit, and persists a fully independent auditable result.",
