  "claims": [
    {
      "id": "claim_390bfd6cff5b45a7b22fd0001593c72f",
      "statement": "LEDGER is a source-grounded framework that replays Git checkpoints, runs OpenWiki at each, and evaluates whether each frozen wiki snapshot's factual claims remain accurate as the source evolves.",
      "evidence": [
        {
          "resource": "repo://evals/ledger/README.md#L1-L9",
          "version": "repo-lines-v1:sha256:096200672afcca792e423428ce79fd2a1724691918e805f3f887d3a5f168560e:"
        }
      ]
    },
    {
      "id": "claim_fc584a79f47942849562fabe266e04e5",
      "statement": "At each checkpoint the evaluator extracts atomic factual claims from every generated Markdown document, ignoring navigation, opinions, instructions, and wiki self-description, and classifies each current-tense claim as supported, stale, invented, or unverified.",
      "evidence": [
        {
          "resource": "repo://evals/ledger/README.md#L11-L27",
          "version": "repo-lines-v1:sha256:d7c01fefa8f739a90c2132f1e47a00d0a53b2caaad491390c8952a0fad8b56ec:"
        }
      ]
    },
    {
      "id": "claim_2d8e4288b9cb4dd88511a021e7d81b6f",
      "statement": "All four LEDGER rates share the count of current claims as their denominator and each checkpoint recomputes the partition from the entire current wiki rather than as a delta or average.",
      "evidence": [
        {
          "resource": "repo://evals/ledger/README.md#L28-L45",
          "version": "repo-lines-v1:sha256:d61106bb6f54efc8cfc85eeeb4b73e2a57d134cdccdbcf43739bd9be928378c5:"
        }
      ]
    },
    {
      "id": "claim_4bf903c9b7544442b9435a2fac8a0228",
      "statement": "The claim evaluation pipeline classifies text units and extracts claims with exact quotes, removes normalized duplicates, matches claims to evaluator-only evidence-map concepts, resolves them to raw source, then labels supported/contradicted/not-addressed, routing contradicted claims to stale or invented via historical evidence and not-addressed to unverified.",
      "evidence": [
        {
          "resource": "repo://evals/ledger/README.md#L46-L70",
          "version": "repo-lines-v1:sha256:c59c55f19ddbab0eb06b0cd2ee727160d8183a03034c311b60e2c20f620f325a:"
        }
      ]
    },
    {
      "id": "claim_81c693db108148cfac295e32efa947fa",
      "statement": "run.ts is the LEDGER harness entrypoint: it resolves config, loads the benchmark, prepares a run directory, drives the System Under Test and the model evaluation backend through runBenchmark, and finalizes the run, persisting a failure audit if the run throws.",
      "evidence": [
        {
