    {
      "id": "claim_eded0cca31184972bc68ec309b3f4011",
      "statement": "OpenWikiIgnore compiles gitignore-style patterns with last-match-wins ordering (so a later ! rule can re-include a path) and matches case-insensitively; before matching, normalizeIgnorePath anchors the path to / and collapses ./ and .. spellings with path.posix.normalize as a security boundary so equivalent spellings like secrets/../secrets/token.txt cannot dodge an anchored rule.",
      "evidence": [
