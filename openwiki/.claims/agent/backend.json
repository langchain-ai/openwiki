    {
      "id": "claim_4f4e60027d4d4dc891a4e4bcd33ba634",
      "statement": "The shell allowlist active under .openwikiignore is an anchored allowlist of two commands (pwd and git rev-parse [--no-pager] HEAD), chosen because arbitrary shell commands cannot be statically proven not to read an ignored path; each entry is fully anchored (^...$) so it cannot be prefixed or chained with a second command.",
      "evidence": [
