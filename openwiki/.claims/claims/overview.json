    {
      "id": "claim_0be8def4ea2b4db4bd5d78ddbb82e027",
      "statement": "Only code-brain (repository) claims exist; claims are persisted as per-page sidecars under the .claims directory relative to the wiki root, and reserved files index.md, log.md, and instructions.md never own claims, and .claims itself is excluded from page paths.",
