    {
      "id": "claim_73a8bb15f3854cee9ca85a7cbbc44ba7",
      "statement": "Claims are mutated through four operations, add, confirm, update, and retract, where add lets OpenWiki allocate the identifier and the others target an existing claim by id; update defaults each unspecified statement or evidence field to the current value, refreshing evidence versions when evidence is omitted.",
      "evidence": [
        {
          "resource": "repo://src/claims/core/types.ts#L46-L132",
          "version": "repo-lines-v1:sha256:ab94fe1e34219dbc9dfd6980befd55217f3300d48596052ea76f4d89866a1a91:"
        }
