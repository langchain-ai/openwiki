    {
      "id": "claim_e80eaf9683da45a798392cf4bb5e61bf",
      "statement": "evaluateCheckpoint is the loop body shared verbatim by the live runner and the saved-run re-evaluator: it extracts the source surface, diffs against the previous checkpoint, advances the sticky forgetting watch set, runs the evaluation backend, and reduces verdicts into claim-state and evaluator-completeness measurements.",
      "evidence": [
        {
          "resource": "repo://evals/ledger/run/evaluate-checkpoint.ts#L157-L321",
