{
  "description": "Human-reviewed calibration cases for atomic extraction, truth-ledger accounting, and bounded refutation.",
  "extractionCases": [
    {
      "content": "See the API page for details.",
      "expected": { "classification": "navigation", "assertions": [] }
    },
    {
      "content": "This wiki documents every export.",
      "expected": { "classification": "meta-artifact", "assertions": [] }
    },
    {
      "content": "Commit abc123 updated the API page.",
      "expected": { "classification": "meta-artifact", "assertions": [] }
    },
    {
      "content": "This tiny library is elegant.",
      "expected": { "classification": "opinion", "assertions": [] }
    },
    {
      "content": "Run the functions manually before publishing.",
      "expected": { "classification": "instruction", "assertions": [] }
    },
    {
      "content": "If validation is added later, update the README.",
      "expected": { "classification": "instruction", "assertions": [] }
    },
    {
      "content": "Because there are no automated tests, run the functions manually.",
      "expected": {
        "classification": "mixed",
        "assertions": [
          {
            "statement": "There are no automated tests.",
            "tense": "current"
          }
        ]
      }
    },
    {
      "content": "Calling add(2, 3) returns 5, and subtract(5, 3) returns 2.",
      "expected": {
        "classification": "factual",
        "assertions": [
          { "statement": "Calling add(2, 3) returns 5.", "tense": "current" },
          {
            "statement": "Calling subtract(5, 3) returns 2.",
            "tense": "current"
          }
        ]
      }
    },
    {
      "content": "negate(x) was removed in version 2.0.0.",
      "expected": {
        "classification": "factual",
        "assertions": [
          {
            "statement": "negate(x) was removed in version 2.0.0.",
            "tense": "historical"
          }
        ]
      }
    },
    {
      "content": "Overview",
      "expected": { "classification": "no-claim", "assertions": [] }
    }
  ],
  "ledgerCases": [
    {
      "assertion": { "statement": "VERSION is 2.0.0.", "tense": "current" },
      "facts": [
        {
          "factId": "version",
          "factVersionId": "version@T2",
          "statement": "VERSION is 2.0.0.",
          "current": true
        }
      ],
      "expected": { "verdict": "supported" }
    },
    {
      "assertion": { "statement": "VERSION is 9.0.0.", "tense": "current" },
      "facts": [
        {
          "factId": "version",
          "factVersionId": "version@T2",
          "statement": "VERSION is 2.0.0.",
          "current": true
        },
        {
          "factId": "version",
          "factVersionId": "version@T0",
          "statement": "VERSION is 1.0.0.",
          "current": false
        }
      ],
      "expected": { "verdict": "contradicted", "formerlyTrue": false }
    },
    {
      "assertion": { "statement": "VERSION is 1.0.0.", "tense": "current" },
      "facts": [
        {
          "factId": "version",
          "factVersionId": "version@T2",
          "statement": "VERSION is 2.0.0.",
          "current": true
        },
        {
          "factId": "version",
          "factVersionId": "version@T0",
          "statement": "VERSION is 1.0.0.",
          "current": false
        }
      ],
      "expected": { "verdict": "contradicted", "formerlyTrue": true }
    },
    {
      "assertion": {
        "statement": "negate(x) was removed.",
        "tense": "historical"
      },
      "facts": [
        {
          "factId": "negate",
          "factVersionId": "negate@T0",
          "statement": "The library provides negate(x).",
          "current": false
        }
      ],
      "expected": { "verdict": "supported" }
    },
    {
      "assertion": {
        "statement": "Maintainers prefer tabs.",
        "tense": "current"
      },
      "facts": [
        {
          "factId": "version",
          "factVersionId": "version@T2",
          "statement": "VERSION is 2.0.0.",
          "current": true
        }
      ],
      "expected": { "verdict": "unaccounted" }
    }
  ],
  "refutationCases": [
    {
      "assertion": "VERSION is 9.0.0.",
      "evidence": [
        {
          "evidenceId": "current-version",
          "sourceRef": "version.ts",
          "observedAtCheckpoint": "T2",
          "current": true,
          "content": "export const VERSION = \"2.0.0\";"
        }
      ],
      "expected": { "verdict": "contradicted", "formerlyTrue": false }
    },
    {
      "assertion": "VERSION is 1.0.0.",
      "evidence": [
        {
          "evidenceId": "current-version",
          "sourceRef": "version.ts",
          "observedAtCheckpoint": "T2",
          "current": true,
          "content": "export const VERSION = \"2.0.0\";"
        },
        {
          "evidenceId": "old-version",
          "sourceRef": "version.ts",
          "observedAtCheckpoint": "T0",
          "current": false,
          "content": "export const VERSION = \"1.0.0\";"
        }
      ],
      "expected": { "verdict": "contradicted", "formerlyTrue": true }
    },
    {
      "assertion": "There is no CI configuration.",
      "evidence": [
        {
          "evidenceId": "readme",
          "sourceRef": "README.md",
          "observedAtCheckpoint": "T2",
          "current": true,
          "content": "A tiny calculator library."
        }
      ],
      "expected": { "verdict": "not-refuted" }
    },
    {
      "assertion": "The repository uses GitHub Actions.",
      "evidence": [
        {
          "evidenceId": "tracked",
          "sourceRef": "git tracked files",
          "observedAtCheckpoint": "T2",
          "current": true,
          "content": "Tracked files: README.md, src/calc.ts, src/version.ts"
        }
      ],
      "expected": { "verdict": "not-refuted" }
    }
  ]
}
